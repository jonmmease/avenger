avenger 1;
import { badge } from 'marks/badge.avenger';
import { files } from 'data.avenger';

chart cartesian as chart {
  data: {
    table: files.rows;
  }
  layout: {
    canvas: {
      height: $canvas_height;
      width: $canvas_width;
    }
    plot: auto;
  }
  param CAST(640.0 AS DOUBLE) as canvas_width;
  param CAST(420.0 AS DOUBLE) as canvas_height;
  param CAST(180.0 AS DOUBLE) as point_size;
  mark badge as imported_badge {
  }
}
