avenger 1;

import 'marks/badge.mark.avenger';

chart cartesian as chart {
  data: { table: 'files.rows'; }

  param as canvas_width {
    type: float64;
    default: 640.0;
  }

  param as canvas_height {
    type: float64;
    default: 420.0;
  }

  param as point_size {
    type: float64;
    default: 180.0;
  }

  layout: {
    canvas: { width: $canvas_width; height: $canvas_height; }
    plot: auto;
  }

  mark badge as imported_badge {}
}
