avenger 1;
chart cartesian as chart {
  data: {
    values: [ {
      id: 'a';
      x: 1.0;
      y: 2.0;
    }
    , {
      id: 'b';
      x: 3.0;
      y: 4.0;
    }
    ];
  }
  layout: {
    canvas: {
      height: $canvas_height;
      width: $canvas_width;
    }
    plot: auto;
  }
  param CAST(640.0 AS DOUBLE) as canvas_width;
  param CAST(420.0 AS DOUBLE) as canvas_height;
  param CAST(80.0 AS DOUBLE) as selected_size;
  store as dragged {
    primary_key: [id];
    field utf8 id;
    field float64 x;
    field float64 y;
  }
  selection as picked {
    combine: union;
    empty: none;
  }
  mark symbol as points {
    fill: direct '#2563eb';
    size: direct 180.0;
    x: encoded "x" {
      scale: linear {
        domain: [0.0, 5.0];
      }
    }
    y: encoded "y" {
      scale: linear {
        domain: [0.0, 5.0];
      }
    }
  }
  mark symbol as selection_indicator {
    data: {
      values: [ {
        x: 4.5;
        y: 4.5;
      }
      ];
    }
    fill: direct '#f59e0b';
    size: direct $selected_size;
    x: encoded "x" {
      scale: linear {
        domain: [0.0, 5.0];
      }
    }
    y: encoded "y" {
      scale: linear {
        domain: [0.0, 5.0];
      }
    }
  }
  mark symbol as drag_indicator {
    data: $dragged;
    fill: direct '#dc2626';
    size: direct 260.0;
    x: encoded "x" {
      scale: linear {
        domain: [0.0, 5.0];
      }
    }
    y: encoded "y" {
      scale: linear {
        domain: [0.0, 5.0];
      }
    }
  }
  on click as toggle_point {
    target: mark points;
    toggle picked {
      clause {
        id: 'clicked';
        equality {
          id {
            field: "id";
            value: datum."id";
          }
        }
      }
    }
    set selected_size to CASE WHEN selection_contains(picked, datum."id") THEN 520.0 ELSE 80.0 END;
  }
  on cursor_moved as drag {
    between: {
      end: mouse_up {
      }
      start: mouse_down {
      }
    }
    filter: datum."id" IS NULL;
    upsert dragged {
      row {
        id: 'drag';
        x: event.coord.x;
        y: event.coord.y;
      }
    }
    set cursor to 'crosshair';
  }
}
