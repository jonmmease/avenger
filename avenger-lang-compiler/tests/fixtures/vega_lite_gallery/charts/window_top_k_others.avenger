avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Top-K Plot with "Others" (`window_top_k_others`).
chart cartesian as window_top_k_others {
  title: 'Top Directors by Average Worldwide Gross';
  data: {
    table: vega.movies;
  }
  layout: {
    canvas: {
      height: 420.0;
      width: 720.0;
    }
    plot: {
      height: 300.0;
      width: 480.0;
    }
  }
  transform aggregate as director_means {
    group_by: "Director";
    expressions: avg("Worldwide Gross") AS aggregate_gross;
  }
  transform window as ranked {
    expressions: row_number() OVER (ORDER BY "aggregate_gross" DESC) AS rank;
  }
  transform calculate as labels {
    expressions: CASE WHEN "rank" < 10 THEN "Director" ELSE 'All Others' END AS ranked_director;
  }
  transform aggregate as ranked_directors {
    group_by: "ranked_director";
    expressions: avg("aggregate_gross") AS gross;
  }
  transform sql {
    query: SELECT * FROM input ORDER BY "gross" DESC;
  }
  mark rect as directors {
    fill: direct '#4c78a8';
    stroke_width: direct 0.0;
    x: encoded 0.0 {
      axis: {
        format: ',.0f';
        tick_count: 3;
        title: '';
      }
      scale: linear {
        zero: true;
      }
    }
    x2: encoded "gross";
    y: encoded "ranked_director" {
      axis: {
        title: '';
      }
      band: 0.0;
      scale: band {
        order_by: (max("gross"));
        padding_inner: 0.1;
        padding_outer: 0.05;
      }
    }
    y2: encoded channel.y {
      band: 1.0;
    }
  }
}
