avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Bar Chart with Label Overlays (`layer_bar_labels_grey`).
chart cartesian as layer_bar_labels_grey {
  data: {
    table: vega.movies;
  }
  layout: {
    canvas: {
      height: 252.0;
      width: 260.0;
    }
    plot: {
      height: 192.0;
      width: 200.0;
    }
  }
  mark group as plot {
    transform calculate as genre_field {
      expressions: COALESCE("Major Genre", 'null') AS genre;
    }
    transform aggregate as genre_means {
      group_by: "genre";
      expressions: avg("IMDB Rating") AS rating;
    }
    transform window as genre_order {
      expressions: row_number() OVER (ORDER BY "genre") AS row_number;
    }
    transform calculate as sort_field {
      expressions: CASE
        WHEN "genre" = 'null' THEN 1
        ELSE -CAST("row_number" AS BIGINT)
      END AS sort_key;
    }
    mark rect as ratings {
      fill: direct '#dddddd';
      stroke_width: direct 0.0;
      x: encoded 0.0 {
        axis: {
          title: 'Mean IMDB Ratings';
        }
        scale: linear {
          domain: [0.0, 10.0];
        }
      }
      x2: encoded "rating";
      y: encoded "genre" {
        axis: {
          visible: false;
        }
        band: 0.0;
        scale: band {
          order_by: max(0 + "sort_key");
          padding_inner: 0.1;
          padding_outer: 0.05;
        }
      }
      y2: encoded channel.y {
        band: 1.0;
      }
    }
    mark text as labels {
      align: direct 'left';
      baseline: direct 'middle';
      color: direct '#000000';
      text: direct "genre";
      x: direct 5.0;
      y: encoded "genre" {
        band: 0.5;
      }
    }
  }
}
