avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Repeated Histogram (`repeat_histogram`).
chart grid_concat as repeat_histogram {
  data: { table: vega.cars; }
  layout: {
    canvas: { height: 708.0; width: 760.0; }
    plot: { height: 615.0; width: 615.0; }
  }
  rows: 2;
  columns: 2;
  spacing: 15;
  column_widths: [px(300), px(300)];
  row_heights: [px(300), px(300)];

  cell cartesian as horsepower at { row: 0; column: 0; } {
    mark group as histogram {
      transform select as values {
        expressions:
          CAST("Horsepower" AS DOUBLE) AS value,
          "Origin" AS origin;
      }
      transform filter { predicate: "value" IS NOT NULL AND "origin" IS NOT NULL; }
      transform calculate as origin_fields {
        expressions: CASE "origin" WHEN 'USA' THEN 0 WHEN 'Japan' THEN 1 ELSE 2 END AS origin_order;
      }
      transform bin as bins {
        field: "value";
        step: 20.0;
        nice: false;
        extent: [40.0, 240.0];
        anchor: 0.0;
        name: 'bin';
      }
      transform aggregate as bin_counts {
        group_by: ["bin_start", "bin_end", "origin", "origin_order"];
        expressions: count(*) AS count;
      }
      transform stack as stacked_counts {
        field: "count";
        group_by: "bin_start";
        sort_by: -"origin_order";
        offset: zero;
        name: 'count_stack';
      }
      mark rect as counts {
        fill: encoded "origin" {
          legend: { visible: false; }
          scale: ordinal {
            domain: ['Europe', 'Japan', 'USA'];
            range: ['#4c78a8', '#f58518', '#e45756'];
          }
        }
        stroke: direct 'white';
        stroke_width: direct 1.0;
        x: encoded "bin_start" {
          axis: { format: '.0f'; title: 'Horsepower (binned)'; }
          scale: linear { domain: [40.0, 240.0]; nice: false; zero: false; }
        }
        x2: encoded "bin_end";
        y: encoded "count_stack_start" {
          axis: { format: '.0f'; title: 'Count of Records'; }
          scale: linear { domain: [0.0, 120.0]; nice: false; zero: true; }
        }
        y2: encoded "count_stack_end";
      }
    }
  }

  cell cartesian as miles_per_gallon at { row: 0; column: 1; } {
    mark group as histogram {
      transform select as values {
        expressions:
          CAST("Miles_per_Gallon" AS DOUBLE) AS value,
          "Origin" AS origin;
      }
      transform filter { predicate: "value" IS NOT NULL AND "origin" IS NOT NULL; }
      transform calculate as origin_fields {
        expressions: CASE "origin" WHEN 'USA' THEN 0 WHEN 'Japan' THEN 1 ELSE 2 END AS origin_order;
      }
      transform bin as bins {
        field: "value";
        step: 5.0;
        nice: false;
        extent: [5.0, 50.0];
        anchor: 0.0;
        name: 'bin';
      }
      transform aggregate as bin_counts {
        group_by: ["bin_start", "bin_end", "origin", "origin_order"];
        expressions: count(*) AS count;
      }
      transform stack as stacked_counts {
        field: "count";
        group_by: "bin_start";
        sort_by: -"origin_order";
        offset: zero;
        name: 'count_stack';
      }
      mark rect as counts {
        fill: encoded "origin" {
          legend: { title: 'Origin'; }
          scale: ordinal {
            domain: ['Europe', 'Japan', 'USA'];
            range: ['#4c78a8', '#f58518', '#e45756'];
          }
        }
        stroke: direct 'white';
        stroke_width: direct 1.0;
        x: encoded "bin_start" {
          axis: { format: '.0f'; title: 'Miles_per_Gallon (binned)'; }
          scale: linear { domain: [5.0, 50.0]; nice: false; zero: false; }
        }
        x2: encoded "bin_end";
        y: encoded "count_stack_start" {
          axis: { format: '.0f'; title: 'Count of Records'; }
          scale: linear { domain: [0.0, 100.0]; nice: false; zero: true; }
        }
        y2: encoded "count_stack_end";
      }
    }
  }

  cell cartesian as acceleration at { row: 1; column: 0; } {
    mark group as histogram {
      transform select as values {
        expressions:
          CAST("Acceleration" AS DOUBLE) AS value,
          "Origin" AS origin;
      }
      transform filter { predicate: "value" IS NOT NULL AND "origin" IS NOT NULL; }
      transform calculate as origin_fields {
        expressions: CASE "origin" WHEN 'USA' THEN 0 WHEN 'Japan' THEN 1 ELSE 2 END AS origin_order;
      }
      transform bin as bins {
        field: "value";
        step: 2.0;
        nice: false;
        extent: [8.0, 26.0];
        anchor: 0.0;
        name: 'bin';
      }
      transform aggregate as bin_counts {
        group_by: ["bin_start", "bin_end", "origin", "origin_order"];
        expressions: count(*) AS count;
      }
      transform stack as stacked_counts {
        field: "count";
        group_by: "bin_start";
        sort_by: -"origin_order";
        offset: zero;
        name: 'count_stack';
      }
      mark rect as counts {
        fill: encoded "origin" {
          legend: { visible: false; }
          scale: ordinal {
            domain: ['Europe', 'Japan', 'USA'];
            range: ['#4c78a8', '#f58518', '#e45756'];
          }
        }
        stroke: direct 'white';
        stroke_width: direct 1.0;
        x: encoded "bin_start" {
          axis: { format: '.1f'; title: 'Acceleration (binned)'; }
          scale: linear { domain: [8.0, 26.0]; nice: false; zero: false; }
        }
        x2: encoded "bin_end";
        y: encoded "count_stack_start" {
          axis: { format: '.0f'; title: 'Count of Records'; }
          scale: linear { domain: [0.0, 130.0]; nice: false; zero: true; }
        }
        y2: encoded "count_stack_end";
      }
    }
  }

  cell cartesian as displacement at { row: 1; column: 1; } {
    mark group as histogram {
      transform select as values {
        expressions:
          CAST("Displacement" AS DOUBLE) AS value,
          "Origin" AS origin;
      }
      transform filter { predicate: "value" IS NOT NULL AND "origin" IS NOT NULL; }
      transform calculate as origin_fields {
        expressions: CASE "origin" WHEN 'USA' THEN 0 WHEN 'Japan' THEN 1 ELSE 2 END AS origin_order;
      }
      transform bin as bins {
        field: "value";
        step: 50.0;
        nice: false;
        extent: [50.0, 500.0];
        anchor: 0.0;
        name: 'bin';
      }
      transform aggregate as bin_counts {
        group_by: ["bin_start", "bin_end", "origin", "origin_order"];
        expressions: count(*) AS count;
      }
      transform stack as stacked_counts {
        field: "count";
        group_by: "bin_start";
        sort_by: -"origin_order";
        offset: zero;
        name: 'count_stack';
      }
      mark rect as counts {
        fill: encoded "origin" {
          legend: { visible: false; }
          scale: ordinal {
            domain: ['Europe', 'Japan', 'USA'];
            range: ['#4c78a8', '#f58518', '#e45756'];
          }
        }
        stroke: direct 'white';
        stroke_width: direct 1.0;
        x: encoded "bin_start" {
          axis: { format: '.0f'; title: 'Displacement (binned)'; }
          scale: linear { domain: [50.0, 500.0]; nice: false; zero: false; }
        }
        x2: encoded "bin_end";
        y: encoded "count_stack_start" {
          axis: { format: '.0f'; title: 'Count of Records'; }
          scale: linear { domain: [0.0, 110.0]; nice: false; zero: true; }
        }
        y2: encoded "count_stack_end";
      }
    }
  }
}
