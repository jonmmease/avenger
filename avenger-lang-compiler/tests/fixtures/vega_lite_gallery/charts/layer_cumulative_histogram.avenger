avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Layered Histogram and Cumulative Histogram (`layer_cumulative_histogram`).
chart cartesian as layer_cumulative_histogram {
  data: { table: vega.movies; }
  layout: {
    canvas: { height: 347.0; width: 362.0; }
    plot: { height: 300.0; width: 300.0; }
  }
  transform select as ratings {
    expressions: CAST("IMDB Rating" AS DOUBLE) AS rating;
  }
  transform filter {
    predicate: "rating" IS NOT NULL;
  }
  transform bin as rating_bins {
    field: "rating";
    step: 1.0;
    nice: false;
    extent: [1.0, 10.0];
    anchor: 0.0;
    name: 'rating_bin';
  }
  transform aggregate as bin_counts {
    group_by: ["rating_bin_start", "rating_bin_end"];
    expressions: count(*) AS count;
  }
  transform window as cumulative_bins {
    expressions: sum("count") OVER (
      ORDER BY "rating_bin_start"
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cumulative_count;
  }
  transform sql {
    query: SELECT * FROM input ORDER BY "rating_bin_start";
  }
  mark group as layers {
    mark rect as cumulative {
      fill: direct '#4c78a8';
      stroke: direct 'white';
      stroke_width: direct 1.0;
      x: encoded "rating_bin_start" {
        axis: { title: 'IMDB Rating'; }
        scale: linear { domain: [1.0, 10.0]; nice: false; zero: false; }
      }
      x2: encoded "rating_bin_end";
      y: encoded 0.0 {
        axis: { format: ',.0f'; title: 'Cumulative Count'; }
        scale: linear { nice: true; zero: true; }
      }
      y2: encoded "cumulative_count";
    }
    mark rect as counts {
      fill: direct 'yellow';
      opacity: direct 0.5;
      stroke: direct 'white';
      stroke_width: direct 1.0;
      x: encoded "rating_bin_start";
      x2: encoded "rating_bin_end";
      y: encoded 0.0;
      y2: encoded "count";
    }
  }
}
