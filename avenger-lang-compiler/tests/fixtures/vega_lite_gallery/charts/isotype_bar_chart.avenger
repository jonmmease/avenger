avenger 1;
import { isotype } from './isotype_data.avenger';

-- | Vega-Lite gallery: Pictorial Bar Chart (`isotype_bar_chart`).
chart facet as isotype_bar_chart {
  data: { table: isotype.animals; }
  layout: { plot: { height: 200.0; width: 800.0; } }
  row: "country" {
    position: left;
    title: '';
    slots: shared;
  }
  cell cartesian {
    mark symbol as animals {
      fill: encoded "animal" {
        legend: { visible: false; }
        scale: ordinal {
          domain: ['cattle', 'pigs', 'sheep'];
          range: ['rgb(194,81,64)', 'rgb(93,93,93)', 'rgb(91,131,149)'];
        }
      }
