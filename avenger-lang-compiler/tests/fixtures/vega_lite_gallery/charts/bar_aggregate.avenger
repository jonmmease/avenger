avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Aggregate Bar Chart (`bar_aggregate`).
chart cartesian as bar_aggregate {
  data: {
    table: vega.population;
  }
  layout: {
    canvas: {
      height: 383.0;
      width: 360.0;
    }
    plot: {
      height: 323.0;
      width: 300.0;
    }
  }
  transform filter {
    predicate: "year" = 2000;
  }
  transform aggregate as age_population {
    group_by: "age";
    expressions: sum("people") AS population;
  }
  mark rect as bars {
    fill: direct '#4c78a8';
    stroke_width: direct 0.0;
    x: encoded 0.0 {
      axis: {
        format: ',.0f';
        tick_count: 4;
        title: 'population';
      }
      scale: linear {
        nice: false;
        zero: true;
      }
    }
    x2: encoded "population";
    y: encoded "age" {
      axis: {
        title: 'age';
      }
      band: 0.0;
      scale: band {
        order_by: max(-CAST("age" AS DOUBLE));
        padding_inner: 0.1;
        padding_outer: 0.05;
      }
    }
    y2: encoded channel.y {
      band: 1.0;
    }
  }
}
