avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Horizontal Stacked Bar Chart (`stacked_bar_h`).
chart cartesian as stacked_bar_h {
  data: {
    table: vega.barley;
  }
  layout: {
    canvas: {
      height: 360.0;
      width: 600.0;
    }
    plot: {
      height: 260.0;
      width: 300.0;
    }
  }
  transform calculate as site_order {
    expressions: CASE "site"
      WHEN 'Crookston' THEN 0
      WHEN 'Duluth' THEN 1
      WHEN 'Grand Rapids' THEN 2
      WHEN 'Morris' THEN 3
      WHEN 'University Farm' THEN 4
      ELSE 5
    END AS stack_order;
  }
  transform aggregate as site_totals {
    group_by: ["variety", "site", "stack_order"];
    expressions: sum("yield") AS site_yield;
  }
  transform stack as stacked_yield {
    field: "site_yield";
    group_by: "variety";
    sort_by: -"stack_order";
    offset: zero;
    name: 'yield_stack';
  }
  transform sql {
    query: SELECT * FROM input ORDER BY "variety", "stack_order";
  }
  mark rect as yields {
    fill: encoded "site" {
      legend: {
        title: 'site';
      }
      scale: ordinal {
        domain: [
          'Crookston',
          'Duluth',
          'Grand Rapids',
          'Morris',
          'University Farm',
          'Waseca'
        ];
        range: ['#4c78a8', '#f58518', '#e45756', '#72b7b2', '#54a24b', '#eeca3b'];
      }
    }
    stroke_width: direct 0.0;
    x: encoded stacked_yield.end {
      axis: {
        title: 'Sum of yield';
      }
      scale: linear {
        domain: [0.0, 500.0];
        nice: false;
        zero: true;
      }
    }
    x2: encoded stacked_yield.start;
    y: encoded "variety" {
      axis: {
        title: 'variety';
      }
      band: 0.0;
      scale: band {
        domain: [
          'Wisconsin No. 38',
          'Velvet',
          'Trebi',
          'Svansota',
          'Peatland',
          'No. 475',
          'No. 462',
          'No. 457',
          'Manchuria',
          'Glabron'
        ];
        padding_inner: 0.08;
        padding_outer: 0.04;
      }
    }
    y2: encoded channel.y {
      band: 1.0;
    }
  }
}
