avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Plot Showing Average Data with Raw Values (`layer_line_mean_point_raw`).
chart cartesian as layer_line_mean_point_raw {
  data: { table: vega.stocks; }
  layout: {
    canvas: { height: 347.0; width: 357.0; }
    plot: { height: 300.0; width: 300.0; }
  }
  transform filter {
    predicate: "symbol" = 'GOOG';
  }
  mark group as layers {
    mark symbol as observations {
      fill: direct 'white';
      opacity: direct 0.3;
      size: direct 30.0;
      stroke: direct '#4c78a8';
      stroke_width: direct 1.5;
      x: encoded DATE_TRUNC('year', "date") {
        axis: { datetime_format: 'yyyy'; title: 'date (year)'; }
        scale: time;
      }
      y: encoded "price" {
        axis: { title: 'price, Mean of price'; }
        scale: linear { domain: [0.0, 800.0]; nice: false; zero: true; }
      }
    }
    mark group as yearly_average {
      transform calculate as temporal_fields {
        expressions: DATE_TRUNC('year', "date") AS year;
      }
      transform aggregate as means {
        group_by: "year";
        expressions: avg("price") AS mean_price;
      }
      transform sql {
        query: SELECT * FROM input ORDER BY "year";
      }
      mark line as mean_price {
        order: direct "year";
        stroke: direct '#4c78a8';
        stroke_width: direct 2.0;
        x: encoded "year";
        y: encoded means.mean_price;
      }
    }
  }
}
