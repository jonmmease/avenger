avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Area Chart (`area`).
chart cartesian as area {
  data: {
    table: vega.unemployment_across_industries;
  }
  layout: {
    canvas: {
      height: 280.0;
      width: 380.0;
    }
    plot: {
      height: 200.0;
      width: 300.0;
    }
  }
  transform time_unit as month {
    field: "date";
    units: [year, month];
    name: 'month';
  }
  transform aggregate as monthly_total {
    group_by: "month_start";
    expressions: sum("count") AS total_count;
  }
  mark area as unemployment {
    fill: direct '#4c78a8';
    order: direct month.start;
    stroke_width: direct 0.0;
    x: encoded month.start {
      axis: {
        title: 'date';
      }
      scale: time;
    }
    y: encoded monthly_total.total_count {
      axis: {
        title: 'count';
      }
      scale: linear {
        nice: false;
        zero: true;
      }
    }
    y2: encoded 0.0;
  }
}
