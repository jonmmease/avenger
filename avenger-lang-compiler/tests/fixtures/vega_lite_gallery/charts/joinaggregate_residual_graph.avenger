avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Calculate Residuals (`joinaggregate_residual_graph`).
chart cartesian as joinaggregate_residual_graph {
  data: {
    table: 'vega.movies';
  }
  layout: {
    canvas: {
      height: 440.0;
      width: 500.0;
    }
    plot: {
      height: 300.0;
      width: 300.0;
    }
  }
  transform sql as movie_residuals {
    query:
      WITH rated AS (
        SELECT
          "Release Date" AS "release_date",
          "IMDB Rating" AS "rating",
          AVG("IMDB Rating") OVER () AS "average_rating"
        FROM input
        WHERE "IMDB Rating" IS NOT NULL
          AND EXTRACT(YEAR FROM "Release Date") <= 2019
      )
      SELECT
        "release_date",
        "rating" - "average_rating" AS "rating_delta"
      FROM rated
      ORDER BY "release_date", "rating_delta";
  }
  mark symbol as movies {
    fill: direct '#ffffff';
    stroke: encoded "rating_delta" {
      legend: {
        title: 'Rating Delta';
      }
      scale: linear {
        domain: [-5.0, 5.0];
        nice: false;
        range: ['#b35806', '#f7f7f7', '#4393c3'];
        zero: true;
      }
    }
    size: direct 20.0;
    stroke_width: direct 1.5;
    x: encoded "release_date" {
      axis: {
        title: 'Release Date';
      }
      scale: time;
    }
    y: encoded "rating_delta" {
      axis: {
        title: 'Rating Delta';
      }
      scale: linear {
        domain: [-5.0, 3.0];
        nice: false;
        zero: true;
      }
    }
  }
}
