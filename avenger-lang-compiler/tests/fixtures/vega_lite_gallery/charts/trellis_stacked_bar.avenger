avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Trellis Stacked Bar Chart (`trellis_stacked_bar`).
schema tables as local {
  table sql as stacked_yields {
    sql:
      WITH ordered AS (
        SELECT
          *,
          CASE "site"
            WHEN 'Crookston' THEN 0
            WHEN 'Duluth' THEN 1
            WHEN 'Grand Rapids' THEN 2
            WHEN 'Morris' THEN 3
            WHEN 'University Farm' THEN 4
            ELSE 5
          END AS "site_order"
        FROM vega.barley
      ), stacked AS (
        SELECT
          "year",
          "variety",
          "site",
          "yield",
          SUM("yield") OVER (
            PARTITION BY "year", "variety"
            ORDER BY "site_order"
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
          ) AS "x1"
        FROM ordered
      )
      SELECT *, "x1" - "yield" AS "x0"
      FROM stacked;
  }
}

chart facet_column as trellis_stacked_bar {
  data: { table: local.stacked_yields; }
  layout: { plot: { height: 200.0; width: 300.0; } }
  column: "year" {
    position: top;
    slots: shared;
    title: 'year';
  }
  cell cartesian {
    mark rect as yields {
      fill: encoded "site" {
        legend: { title: 'site'; }
        scale: ordinal {
          domain: ['Crookston', 'Duluth', 'Grand Rapids', 'Morris', 'University Farm', 'Waseca'];
          range: ['#4c78a8', '#f58518', '#e45756', '#72b7b2', '#54a24b', '#eeca3b'];
        }
      }
      stroke_width: direct 0.0;
      x: encoded "x0" {
        axis: { title: 'Sum of yield'; }
        scale: linear { domain: [0.0, 260.0]; nice: false; zero: true; }
      }
      x2: encoded "x1";
      y: encoded "variety" {
        axis: { title: 'variety'; }
        band: 0.0;
        scale: band {
          domain: [
            'Wisconsin No. 38',
            'Velvet',
            'Trebi',
            'Svansota',
            'Peatland',
            'No. 475',
            'No. 462',
            'No. 457',
            'Manchuria',
            'Glabron'
          ];
          padding_inner: 0.1;
          padding_outer: 0.05;
        }
      }
      y2: encoded channel.y { band: 1.0; }
    }
  }
}
