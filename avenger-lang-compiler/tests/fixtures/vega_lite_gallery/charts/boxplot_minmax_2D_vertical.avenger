avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Box Plot with Min/Max Whiskers (`boxplot_minmax_2D_vertical`).
schema tables as local {
  table sql as body_mass_summary {
    sql:
      SELECT
        "Species",
        MIN(CAST("Body Mass (g)" AS DOUBLE)) AS "minimum",
        approx_percentile_cont(CAST("Body Mass (g)" AS DOUBLE), 0.25) AS "q1",
        median(CAST("Body Mass (g)" AS DOUBLE)) AS "median",
        approx_percentile_cont(CAST("Body Mass (g)" AS DOUBLE), 0.75) AS "q3",
        MAX(CAST("Body Mass (g)" AS DOUBLE)) AS "maximum"
      FROM vega.penguins
      WHERE "Body Mass (g)" IS NOT NULL
      GROUP BY "Species";
  }
}

chart cartesian as boxplot_minmax_2D_vertical {
  data: { table: local.body_mass_summary; }
  layout: {
    canvas: { height: 386.0; width: 121.0; }
    plot: { height: 300.0; width: 60.0; }
  }
  mark group as box_plot {
    mark rule as whiskers {
      stroke: direct '#666666';
      stroke_width: direct 1.0;
      x: encoded "Species" {
        band: 0.5;
        axis: { label_angle: -90.0; title: 'Species'; }
        scale: band {
          domain: ['Adelie', 'Chinstrap', 'Gentoo'];
          padding_inner: 0.15;
          padding_outer: 0.05;
        }
      }
      x2: encoded channel.x { band: 0.5; }
      y: encoded "minimum" {
        axis: { format: ',.0f'; title: 'Body Mass (g)'; }
        scale: linear { domain: [2500.0, 6500.0]; nice: false; zero: false; }
      }
      y2: encoded "maximum";
    }
    mark rect as box {
      fill: encoded "Species" {
        legend: { visible: false; }
        scale: ordinal {
          domain: ['Adelie', 'Chinstrap', 'Gentoo'];
          range: ['#4c78a8', '#f58518', '#e45756'];
        }
      }
      stroke: direct '#666666';
      stroke_width: direct 1.0;
      x: encoded "Species" { band: 0.15; }
      x2: encoded channel.x { band: 0.85; }
      y: encoded "q1";
      y2: encoded "q3";
    }
    mark rule as lower_caps {
      stroke: direct '#666666';
      stroke_width: direct 1.0;
      x: encoded "Species" { band: 0.3; }
      x2: encoded channel.x { band: 0.7; }
      y: encoded "minimum";
      y2: encoded "minimum";
    }
    mark rule as upper_caps {
      stroke: direct '#666666';
      stroke_width: direct 1.0;
      x: encoded "Species" { band: 0.3; }
      x2: encoded channel.x { band: 0.7; }
      y: encoded "maximum";
      y2: encoded "maximum";
    }
    mark rule as medians {
      stroke: direct '#ffffff';
      stroke_width: direct 1.0;
      x: encoded "Species" { band: 0.15; }
      x2: encoded channel.x { band: 0.85; }
      y: encoded "median";
      y2: encoded "median";
    }
  }
}
