avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Calculate Difference from Average (`joinaggregate_mean_difference`).
chart cartesian as joinaggregate_mean_difference {
  data: {
    table: 'vega.movies';
  }
  layout: {
    canvas: {
      height: 440.0;
      width: 620.0;
    }
    plot: {
      height: 360.0;
      width: 300.0;
    }
  }
  transform sql as exceptional_movies {
    query:
      WITH rated AS (
        SELECT
          "Title",
          "IMDB Rating" AS "rating",
          AVG("IMDB Rating") OVER () AS "average_rating"
        FROM input
        WHERE "IMDB Rating" IS NOT NULL
      ), exceptional AS (
        SELECT *
        FROM rated
        WHERE "rating" - "average_rating" > 2.5
      )
      SELECT
        "Title",
        "rating",
        "average_rating",
        ROW_NUMBER() OVER (ORDER BY "Title") AS "rank"
      FROM exceptional
      ORDER BY "Title";
  }
  mark group as plot {
    mark rect as ratings {
      fill: direct '#4c78a8';
      stroke_width: direct 0.0;
      x: encoded 0.0 {
        axis: {
          title: 'IMDB Rating';
        }
        scale: linear {
          domain: [0.0, 10.0];
          nice: false;
          zero: true;
        }
      }
      x2: encoded "rating";
      y: encoded "Title" {
        axis: {
          title: 'Title';
        }
        band: 0.0;
        scale: band {
          order_by: max(-CAST("rank" AS DOUBLE));
          padding_inner: 0.1;
          padding_outer: 0.05;
        }
      }
      y2: encoded channel.y {
        band: 1.0;
      }
    }
    mark rule as average {
      stroke: direct 'red';
      stroke_width: direct 1.0;
      x: encoded "average_rating";
      x2: encoded "average_rating";
      y: direct 0.0;
      y2: direct 360.0;
    }
  }
}
