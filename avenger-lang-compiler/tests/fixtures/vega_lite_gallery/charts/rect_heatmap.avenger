avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Table Heatmap (`rect_heatmap`).
chart cartesian as rect_heatmap {
  data: {
    table: vega.cars;
  }
  layout: {
    canvas: {
      height: 220.0;
      width: 400.0;
    }
    plot: {
      height: 120.0;
      width: 240.0;
    }
  }
  transform aggregate as mean_horsepower {
    group_by: ["Origin", "Cylinders"];
    expressions: avg("Horsepower") AS mean_horsepower;
  }
  mark rect as cells {
    fill: encoded "mean_horsepower" {
      legend: {
        title: 'Mean of Horsepower';
      }
      scale: linear;
    }
    stroke_width: direct 0.0;
    x: encoded "Cylinders" {
      axis: {
        title: 'Cylinders';
      }
      band: 0.0;
      scale: band {
        domain: [3, 4, 5, 6, 8];
        padding_inner: 0.0;
        padding_outer: 0.0;
      }
    }
    x2: encoded channel.x {
      band: 1.0;
    }
    y: encoded "Origin" {
      axis: {
        title: 'Origin';
      }
      band: 0.0;
      scale: band {
        domain: ['USA', 'Japan', 'Europe'];
        padding_inner: 0.0;
        padding_outer: 0.0;
      }
    }
    y2: encoded channel.y {
      band: 1.0;
    }
  }
}
