avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Line chart with varying stroke dash (`line_strokedash`).
chart cartesian as line_strokedash {
  data: {
    table: vega.stocks;
  }
  layout: {
    canvas: {
      height: 440.0;
      width: 500.0;
    }
    plot: {
      height: 340.0;
      width: 340.0;
    }
  }
  transform select as prices {
    expressions: "symbol", "date", "price";
  }
  transform sql as ordered_prices {
    query: SELECT * FROM input ORDER BY "symbol", "date";
  }
  mark line as stocks {
    order: direct "date";
    stroke: direct '#4c78a8';
    stroke_dash: encoded "symbol" {
      legend: {
        title: 'symbol';
      }
      scale: ordinal {
        domain: ['AAPL', 'AMZN', 'GOOG', 'IBM', 'MSFT'];
        range: ['solid', 'dashed', 'dotted', 'dashdot', 'longshort'];
      }
    }
    stroke_width: direct 2.0;
    x: encoded "date" {
      axis: {
        title: 'date';
      }
      scale: time;
    }
    y: encoded "price" {
      axis: {
        title: 'price';
      }
      scale: linear {
        domain: [0.0, 800.0];
        nice: false;
        zero: true;
      }
    }
  }
}
