avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Annual Weather Heatmap (`rect_heatmap_weather`).
chart cartesian as rect_heatmap_weather {
  title: 'Daily Max Temperatures (C) in Seattle, WA';
  data: { table: vega.seattle_weather; }
  layout: {
    canvas: { height: 300.0; width: 620.0; }
    plot: { height: 156.0; width: 403.0; }
  }
  transform calculate as calendar_fields {
    expressions:
      CAST(EXTRACT(DAY FROM "date") AS BIGINT) AS day,
      CAST(EXTRACT(MONTH FROM "date") AS BIGINT) AS month_number,
      CASE CAST(EXTRACT(MONTH FROM "date") AS BIGINT)
        WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar'
        WHEN 4 THEN 'Apr' WHEN 5 THEN 'May' WHEN 6 THEN 'Jun'
        WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug' WHEN 9 THEN 'Sep'
        WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' ELSE 'Dec'
      END AS month;
  }
  transform aggregate as daily_monthly_maximum {
    group_by: ["day", "month_number", "month"];
    expressions: max("temp_max") AS maximum_temperature;
  }
  mark rect as days {
    fill: encoded "maximum_temperature" {
      legend: { title: ''; }
      scale: linear {
        domain: [6.0, 36.0];
        range: ['#edf8b1', '#7fcdbb', '#2c7fb8', '#253494'];
        zero: false;
      }
    }
    stroke_width: direct 0.0;
    x: encoded "day" {
      axis: { label_angle: 0.0; title: 'Day'; }
      band: 0.0;
      scale: band { padding_inner: 0.0; padding_outer: 0.0; }
    }
    x2: encoded channel.x { band: 1.0; }
    y: encoded "month" {
      axis: { title: 'Month'; }
      band: 0.0;
      scale: band {
        domain: ['Dec', 'Nov', 'Oct', 'Sep', 'Aug', 'Jul', 'Jun', 'May', 'Apr', 'Mar', 'Feb', 'Jan'];
        padding_inner: 0.0;
        padding_outer: 0.0;
      }
    }
    y2: encoded channel.y { band: 1.0; }
  }
}
