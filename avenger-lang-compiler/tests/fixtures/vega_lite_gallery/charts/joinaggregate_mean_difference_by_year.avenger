avenger 1;
import { vega } from '../catalog.avenger';

-- | Vega-Lite gallery: Calculate Difference from Annual Average (`joinaggregate_mean_difference_by_year`).
chart cartesian as joinaggregate_mean_difference_by_year {
  data: {
    table: vega.movies;
  }
  layout: {
    canvas: {
      height: 440.0;
      width: 620.0;
    }
    plot: {
      height: 360.0;
      width: 300.0;
    }
  }
  transform filter {
    predicate: "IMDB Rating" IS NOT NULL;
  }
  transform calculate as dated {
    expressions:
      "IMDB Rating" AS rating,
      EXTRACT(YEAR FROM "Release Date") AS year;
  }
  transform join_aggregate as rating_summary {
    group_by: "year";
    expressions: avg("rating") AS average_year_rating;
  }
  transform filter {
    predicate: "rating" - "average_year_rating" > 2.5;
  }
  transform window as exceptional_movies {
    expressions: row_number() OVER (ORDER BY "Title") AS rank;
  }
  transform sql {
    query: SELECT * FROM input ORDER BY "Title";
  }
  mark group as plot {
    mark rect as ratings {
      fill: direct '#4c78a8';
      stroke_width: direct 0.0;
      x: encoded 0.0 {
        axis: {
          title: 'IMDB Rating';
        }
        scale: linear {
          domain: [0.0, 10.0];
          nice: false;
          zero: true;
        }
      }
      x2: encoded "rating";
      y: encoded "Title" {
        axis: {
          title: 'Title';
        }
        band: 0.0;
        scale: band {
          order_by: max(-CAST("rank" AS DOUBLE));
          padding_inner: 0.1;
          padding_outer: 0.05;
        }
      }
      y2: encoded channel.y {
        band: 1.0;
      }
    }
    mark rule as annual_average {
      stroke: direct 'red';
      stroke_width: direct 1.0;
      x: encoded "average_year_rating";
      x2: encoded "average_year_rating";
      y: encoded "Title" {
        band: 0.15;
      }
      y2: encoded "Title" {
        band: 0.85;
      }
    }
  }
}
