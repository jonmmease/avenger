avenger 1;
import { pass } from './transforms.avenger';
import { shared } from './data.avenger';

chart cartesian as cartesian {
  data: {
    table: 'shared.points';
  }
  param CAST(64.0 AS DOUBLE) as point_size;
  transform pass {
  }
  mark symbol as points {
    size: direct $point_size;
    x: encoded "x";
    y: encoded "y";
  }
}

chart geo as geo {
  center_lon_lat: [-73.9857, 40.7484];
  projection: mercator;
  zoom: 10;
  param CAST(80.0 AS DOUBLE) as station_size;
  mark symbol as station {
    lon_lat: [-73.9857, 40.7484];
    size: direct $station_size;
  }
}

chart polar as polar {
  data: {
    table: 'shared.points';
  }
  param CAST(72.0 AS DOUBLE) as point_size;
  transform pass {
  }
  mark symbol as points {
    r: encoded "radius";
    size: direct $point_size;
    theta: encoded "theta";
  }
}
