avenger 1;
import { pass, shared } from 'shared.avenger';

chart polar as polar {
  data: {
    table: 'shared.points';
  }
  param float64 as point_size {
    value: 72.0;
  }
  transform pass {
  }
  mark symbol as points {
    r: encoded "radius";
    size: direct $point_size;
    theta: encoded "theta";
  }
}
