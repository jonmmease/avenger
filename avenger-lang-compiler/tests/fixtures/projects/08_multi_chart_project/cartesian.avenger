avenger 1;

import { pass } from 'pass.transform.avenger';
import { shared } from 'shared.data.avenger';

chart cartesian as cartesian {
  param float64 as point_size { value: 64.0; }
  data: { table: 'shared.points'; }
  transform pass { }
  mark symbol as points {
    x: "x";
    y: "y";
    size: value $point_size;
  }
}
