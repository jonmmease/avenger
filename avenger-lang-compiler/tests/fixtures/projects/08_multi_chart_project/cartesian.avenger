avenger 1;
import { pass, shared } from 'shared.avenger';

chart cartesian as cartesian {
  data: {
    table: 'shared.points';
  }
  param float64 as point_size {
    value: 64.0;
  }
  transform pass {
  }
  mark symbol as points {
    size: direct $point_size;
    x: encoded "x";
    y: encoded "y";
  }
}
