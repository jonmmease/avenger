avenger 1;
chart facet_wrap as facet {
  data: {
    values: [ {
      category: 'a';
      region: 'east';
      value: 2.0;
    }
    , {
      category: 'b';
      region: 'west';
      value: 3.0;
    }
    ];
  }
  facet: "region" {
    slots: shared;
  }
  cell cartesian {
    mark symbol {
      size: direct 256.0;
      x: encoded "category";
      y: encoded "value";
    }
  }
}
