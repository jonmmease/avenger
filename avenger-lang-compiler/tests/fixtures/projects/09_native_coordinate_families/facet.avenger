avenger 1;

chart facet_wrap as facet {
  data: {
    values: [
      { region: 'east'; category: 'a'; value: 2.0; },
      { region: 'west'; category: 'b'; value: 3.0; }
    ];
  }
  facet: "region" { slots: shared; }
  cell cartesian {
    mark symbol { x: "category"; y: "value"; size: value 256.0; }
  }
}
