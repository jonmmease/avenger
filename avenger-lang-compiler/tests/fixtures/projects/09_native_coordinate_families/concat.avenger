avenger 1;
chart hconcat as concat {
  data: {
    values: [ {
      x: 1.0;
      y: 2.0;
    }
    ];
  }
  spacing: 12;
  cell cartesian as left {
    mark symbol {
      x: encoded "x";
      y: encoded "y";
    }
  }
  cell polar as right {
    mark symbol {
      r: encoded "y" {
        scale: linear {
          domain: [0.0, 2.5];
        }
      }
      theta: encoded "x";
    }
  }
}
