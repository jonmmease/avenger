avenger 1;

chart cartesian as subplot {
  data: {
    values: [{ x: 1.0; y: 2.0; r: 3.0; theta: 0.5; category: 'a'; }];
  }
  mark subplot as inset {
    x: avg("x") { scale: linear { domain: [0.0, 2.0]; } }
    y: avg("y") { scale: linear { domain: [0.0, 4.0]; } }
    key: "category";
    width: 120;
    height: 90;
    plot polar {
      mark symbol {
        r: "r" { scale: linear { domain: [0.0, 4.0]; } }
        theta: "theta";
        size: value 80.0;
      }
    }
  }
}
