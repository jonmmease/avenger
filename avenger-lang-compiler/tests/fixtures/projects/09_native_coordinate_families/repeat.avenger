avenger 1;
chart repeat_wrap as repeat {
  columns: 2;
  data: {
    values: [ {
      horsepower: 110.0;
      mpg: 21.0;
    }
    ];
  }
  variable item mpg {
    expr: "mpg";
    title: 'MPG';
  }
  variable item horsepower {
    expr: "horsepower";
    title: 'Horsepower';
  }
  cell cartesian {
    mark symbol {
      x: encoded repeat.item;
      y: encoded repeat.item;
    }
  }
}
