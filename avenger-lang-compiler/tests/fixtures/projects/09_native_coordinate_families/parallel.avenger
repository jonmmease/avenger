avenger 1;

chart parallel as parallel {
  dimensions: {
    horsepower: {
      axis: {
        title: 'Horsepower';
        grid: true;
      }
    }
    mileage: {}
  }
  order: [horsepower, mileage];
  data: {
    values: [
      { horsepower: 110.0; mileage: 21.0; },
      { horsepower: 75.0; mileage: 35.0; }
    ];
  }
  mark parallel_line as line {
    dimensions: {
      horsepower: "horsepower";
      mileage: "mileage";
    }
    stroke: value '#4682b4';
  }
}
