avenger 1;
chart parallel as parallel {
  data: {
    values: [ {
      horsepower: 110.0;
      mileage: 21.0;
    }
    , {
      horsepower: 75.0;
      mileage: 35.0;
    }
    ];
  }
  dimensions: {
    horsepower: {
      axis: {
        grid: true;
        title: 'Horsepower';
      }
    }
    mileage: {
    }
  }
  order: [horsepower, mileage];
  mark parallel_line as line {
    dimensions: {
      horsepower: encoded "horsepower";
      mileage: encoded "mileage";
    }
    stroke: direct '#4682b4';
  }
}
