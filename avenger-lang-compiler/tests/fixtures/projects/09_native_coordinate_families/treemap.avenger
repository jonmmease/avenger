avenger 1;
chart treemap as treemap {
  data: {
    values: [ {
      category: 'a';
      region: 'east';
      value: 2.0;
    }
    , {
      category: 'b';
      region: 'west';
      value: 3.0;
    }
    ];
  }
  path: ["region", "category"];
  value: sum("value");
  mark tree_rect as cells {
    fill: encoded "region";
  }
  mark tree_label as labels {
    text: encoded "category";
  }
}
