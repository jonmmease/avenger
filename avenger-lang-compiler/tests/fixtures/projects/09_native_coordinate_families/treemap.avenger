avenger 1;

chart treemap as treemap {
  data: {
    values: [
      { region: 'east'; category: 'a'; value: 2.0; },
      { region: 'west'; category: 'b'; value: 3.0; }
    ];
  }
  path: ["region", "category"];
  value: sum("value");
  mark tree_rect as cells {
    fill: "region";
  }
  mark tree_label as labels {
    text: "category";
  }
}
