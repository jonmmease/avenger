avenger 1;
import { inspect_points } from 'inspect_points.avenger';

chart cartesian as chart {
  data: {
    values: [ {
      id: 'a';
      x: 1.0;
      y: 2.0;
    }
    , {
      id: 'b';
      x: 2.0;
      y: 1.0;
    }
    ];
  }
  tool inspect_points as inspector {
    target: points;
  }
  mark symbol as points {
    details: [id];
    size: direct 80;
    x: encoded "x" {
      scale: linear {
        domain: [0.0, 3.0];
      }
    }
    y: encoded "y" {
      scale: linear {
        domain: [0.0, 3.0];
      }
    }
  }
}
