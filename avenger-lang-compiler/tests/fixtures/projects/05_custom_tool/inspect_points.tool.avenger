avenger 1;

define tool inspect_points {
  slot ref target { kind: mark; }
  export enabled;
  export hovered;
  export chrome_layer.chrome as chrome;

  param boolean as enabled {
    value: true;
  }
  param list(float64) as x_domain {
    value: NULL;
  }
  param selection as hovered {
    empty: none;
  }
  param selection as nested_selected {
    empty: none;
  }

  scale_edit {
    channel: x;
    raw_domain: $x_domain;
  }

  tool point_selection as nested {
    selection: nested_selected;
    fields: [id];
  }

  on click {
    target: mark target;
    set enabled = NOT $enabled;
    set hovered = clear;
  }

  mark group as chrome_layer {
    mark symbol as chrome {
      x: "x";
      y: "y";
      fill: value '#dc2626';
      size: value 24;
      visible: $enabled;
    }
  }
}
