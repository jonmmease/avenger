avenger 1;
export define tool inspect_points {
  slot ref target {
    kind: mark;
  }
  export enabled;
  export hovered;
  export chrome_layer.chrome as chrome;
  param true as enabled;
  param CAST(NULL AS DOUBLE[]) as x_domain;
  selection as hovered {
    empty: none;
  }
  selection as nested_selected {
    empty: none;
  }
  scale_edit {
    channel: x;
    raw_domain: $x_domain;
  }
  tool point_selection as nested {
    fields: [id];
    selection: nested_selected;
  }
  on click {
    target: mark target;
    set enabled to NOT $enabled;
    clear hovered;
  }
  mark group as chrome_layer {
    mark symbol as chrome {
      fill: direct '#dc2626';
      size: direct 24;
      visible: $enabled;
      x: encoded "x";
      y: encoded "y";
    }
  }
}
