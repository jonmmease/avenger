avenger 1;

chart cartesian as aggregate_chart {
  data: {
    values: [
      { category: 'A'; amount: 2.0; },
      { category: 'A'; amount: 3.0; },
      { category: 'B'; amount: 4.0; }
    ];
  }
  transform aggregate as totals {
    group_by: "category";
    expressions: sum("amount") AS total, count(*) AS count;
  }
  mark symbol { x: "category"; y: totals.total; }
}

chart cartesian as join_aggregate_chart {
  data: {
    values: [
      { category: 'A'; amount: 2.0; },
      { category: 'A'; amount: 3.0; },
      { category: 'B'; amount: 4.0; }
    ];
  }
  transform join_aggregate as totals {
    group_by: "category";
    expressions: sum("amount") AS total;
  }
  mark symbol { x: "amount"; y: totals.total; }
}

chart cartesian as scalar_aggregate_chart {
  data: {
    values: [
      { category: 'A'; amount: 2.0; },
      { category: 'B'; amount: 4.0; }
    ];
  }
  transform scalar_aggregate as summary {
    evaluation: eager;
    expressions: avg("amount") AS average;
  }
  mark symbol { x: "amount"; y: summary.average; }
}

chart cartesian as calculate_chart {
  data: {
    values: [
      { category: 'A'; amount: 2.0; },
      { category: 'B'; amount: 4.0; }
    ];
  }
  transform calculate as calculated {
    expressions: "amount" * 2.0 AS doubled;
  }
  mark symbol { x: "amount"; y: calculated.doubled; }
}

chart cartesian as window_chart {
  data: {
    values: [
      { category: 'A'; amount: 2.0; },
      { category: 'B'; amount: 4.0; }
    ];
  }
  transform window as numbered {
    order_by: "amount";
    expressions: row_number() OVER () AS ordinal;
  }
  mark symbol { x: "amount"; y: numbered.ordinal; }
}

chart cartesian as select_chart {
  data: {
    values: [
      { category: 'A'; amount: 2.0; },
      { category: 'B'; amount: 4.0; }
    ];
  }
  transform select as selected {
    expressions: "category", "amount" * 2.0 AS doubled;
  }
  mark symbol { x: "category"; y: selected.doubled; }
}
