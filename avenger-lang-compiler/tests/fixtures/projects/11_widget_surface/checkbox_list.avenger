avenger 1;
chart zerod as checkbox_list {
  selection as regions {
    combine: union;
    empty: none;
  }
  widget checkbox_list as region_picker {
    data: {
      values: [ {
        label: 'East';
        value: 'east';
      }
      , {
        label: 'West';
        value: 'west';
      }
      ];
    }
    position: right;
    selection: regions;
  }
}
