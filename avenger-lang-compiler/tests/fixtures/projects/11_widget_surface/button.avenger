avenger 1;
chart zerod as button {
  param 'initial' as query;
  store as history {
    primary_key: [id];
    field utf8 id;
  }
  selection as picked {
    combine: union;
    empty: none;
  }
  widget button as clear {
    action: {
      set query = '';
      set history = insert_rows {
        row {
          id: 'clear';
        }
      }
      set picked = clear;
    }
    label: 'Clear';
    position: right;
    variant: accent;
  }
  mark text as activation_label {
    text: direct $clear.activations;
  }
}
