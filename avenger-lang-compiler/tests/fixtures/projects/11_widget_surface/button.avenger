avenger 1;

chart zerod as button {
  param utf8 as query {
    value: 'initial';
  }
  param store as history {
    field utf8 id;
    primary_key: [id];
  }
  param selection as picked {
    empty: none;
    combine: union;
  }

  widget button as clear {
    position: right;
    label: 'Clear';
    variant: accent;
    action: {
      set query = '';
      set history = insert_rows {
        row { id: 'clear'; }
      }
      set picked = clear;
    }
  }

  mark text as activation_label {
    text: value $clear.activations;
  }
}
