avenger 1;
chart zerod as button {
  param utf8 as query {
    value: 'initial';
  }
  param store as history {
    primary_key: [id];
    field utf8 id;
  }
  param selection as picked {
    combine: union;
    empty: none;
  }
  widget button as clear {
    action: {
      set query = '';
      set history = insert_rows {
        row {
          id: 'clear';
        }
      }
      set picked = clear;
    }
    label: 'Clear';
    position: right;
    variant: accent;
  }
  mark text as activation_label {
    text: direct $clear.activations;
  }
}
