avenger 1;

export schema tables as local {
  table inline as trips {
    values: [
      { borough: 'Manhattan'; fare: 12; },
      { borough: 'Queens'; fare: 18; },
    ];
  }

  table sql as borough_trips {
    param utf8 as borough { value: 'Manhattan'; }
    param int64 as min_fare { value: 0; }
    sql:
      SELECT "borough", "fare"
      FROM local.trips
      WHERE "borough" = $borough AND "fare" >= $min_fare;
  }

  table sql as forwarded {
    param utf8 as requested { value: 'Queens'; }
    sql:
      SELECT "borough", "fare"
      FROM borough_trips(borough => $requested, min_fare => 10);
  }

  table sql as configured {
    param struct(field(utf8, 'label'), field(int64, 'weight')) as config {
      value: { label: 'base'; weight: 2; }
    }
    sql: SELECT $config AS settings;
  }

  table sql as configured_forwarded {
    param struct(field(utf8, 'label'), field(int64, 'weight')) as forwarded_settings {
      value: { label: 'forwarded'; weight: 3; }
    }
    sql:
      SELECT *
      FROM configured(config => $forwarded_settings);
  }
}
