avenger 1;
export schema tables as local {
  table inline as trips {
    values: [ {
      borough: 'Manhattan';
      fare: 12;
    }
    , {
      borough: 'Queens';
      fare: 18;
    }
    ];
  }
  table sql as borough_trips {
    sql: SELECT "borough", "fare" FROM local.trips WHERE "borough" = $borough AND "fare" >= $min_fare;
    param 'Man' || 'hattan' as borough;
    param (2 * 0.5) as min_fare;
  }
  table sql as forwarded {
    sql: SELECT "borough", "fare" FROM borough_trips(borough => $requested, min_fare => 10);
    param 'Queens' as requested;
  }
  table sql as configured {
    sql: SELECT $config AS settings;
    param named_struct('label', upper('base'), 'weight', CAST(1 + 1.5 AS BIGINT)) as config;
  }
  table sql as configured_forwarded {
    sql: SELECT * FROM configured(config => $forwarded_settings);
    param named_struct('label', upper('forwarded'), 'weight', CAST(1 + 2.5 AS BIGINT)) as forwarded_settings;
  }
}
