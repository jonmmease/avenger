avenger 1;
import { local } from 'data.avenger';

chart cartesian as chart {
  data: {
    borough: concat($selected, '');
    min_fare: 2 + 3.5;
    table: 'local.borough_trips';
  }
  param utf8 as selected {
    value: 'Manhattan';
  }
  mark symbol {
    x: encoded "borough";
    y: encoded "fare";
  }
}
