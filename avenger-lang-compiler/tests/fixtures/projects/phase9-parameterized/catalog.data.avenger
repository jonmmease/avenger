avenger 1;

schema tables as local {
  table inline as trips {
    values: [
      { borough: 'Manhattan'; fare: 12; },
      { borough: 'Queens'; fare: 18; },
    ];
  }

  table sql as borough_trips {
    param as borough { type: utf8; default: 'Manhattan'; }
    param as min_fare { type: int64; default: 0; }
    sql:
      SELECT "borough", "fare"
      FROM local.trips
      WHERE "borough" = $borough AND "fare" >= $min_fare;
  }

  table sql as forwarded {
    param as requested { type: utf8; default: 'Queens'; }
    sql:
      SELECT "borough", "fare"
      FROM borough_trips(borough => $requested, min_fare => 10);
  }

  table sql as configured {
    param as config {
      type: struct(field('label', utf8), field('weight', int64));
      default: { label: 'base'; weight: 2; }
    }
    sql: SELECT $config AS settings;
  }

  table sql as configured_forwarded {
    param as forwarded_settings {
      type: struct(field('label', utf8), field('weight', int64));
      default: { label: 'forwarded'; weight: 3; }
    }
    sql:
      SELECT *
      FROM configured(config => $forwarded_settings);
  }
}
