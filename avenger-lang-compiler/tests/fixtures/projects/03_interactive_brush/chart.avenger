avenger 1;
chart cartesian as chart {
  data: {
    values: [ {
      id: 'a';
      x: 1.0;
      y: 2.0;
    }
    , {
      id: 'b';
      x: 3.0;
      y: 4.0;
    }
    ];
  }
  param float64 as drag_x {
    sharing: free;
    value: 0.0;
  }
  param int64 as hover_count {
    value: 0;
  }
  param store as hovered {
    primary_key: [id];
    field utf8 id;
    field float64 x;
  }
  param selection as picked {
    combine: union;
    empty: none;
  }
  mark symbol as points {
    x: encoded "x";
    y: encoded "y";
  }
  on cursor_moved as drag {
    between: {
      end: mouse_up {
      }
      start: mouse_down {
      }
    }
    set drag_x at start = event.coord.x;
    set hovered = insert_rows {
      row {
        id: 'drag';
        x: event.coord.x;
      }
    }
    set hover_count = (SELECT count(*) FROM $hovered);
    set picked = upsert_clauses {
      clause {
        id: 'drag';
        interval {
          x {
            field: "x";
            from: event.start.coord.x;
            to: event.coord.x;
          }
        }
      }
    }
    set cursor = 'crosshair';
  }
}
