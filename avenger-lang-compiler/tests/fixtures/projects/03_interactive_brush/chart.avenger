avenger 1;
chart cartesian as chart {
  data: {
    values: [ {
      id: 'a';
      x: 1.0;
      y: 2.0;
    }
    , {
      id: 'b';
      x: 3.0;
      y: 4.0;
    }
    ];
  }
  selection as picked {
    combine: union;
    empty: none;
  }
  tool box_selection as brush {
    selection: picked;
    channels: [x, y];
    x_dimension: "x";
    y_dimension: "y";
  }
  mark symbol as points {
    x: encoded "x";
    y: encoded "y";
    fill: direct '#cbd5e1' {
      when {
        predicate: $picked;
        direct: '#2563eb';
      }
    }
  }
}
