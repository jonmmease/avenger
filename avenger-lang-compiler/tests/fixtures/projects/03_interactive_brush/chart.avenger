avenger 1;

chart cartesian as chart {
  param float64 as drag_x {
    value: 0.0;
    sharing: free;
  }
  param int64 as hover_count {
    value: 0;
  }

  param store as hovered {
    field utf8 id;
    field float64 x;
    primary_key: [id];
  }

  param selection as picked {
    empty: none;
    combine: union;
  }

  data: {
    values: [
      { id: 'a'; x: 1.0; y: 2.0; },
      { id: 'b'; x: 3.0; y: 4.0; }
    ];
  }

  mark symbol as points {
    x: "x";
    y: "y";
  }

  on cursor_moved as drag {
    between: {
      start: mouse_down {}
      end: mouse_up {}
    }

    set drag_x at start = event_coord(x);
    set hovered = insert_rows {
      row { id: 'drag'; x: event_coord(x); }
    }
    set hover_count = (SELECT count(*) FROM $hovered);
    set picked = upsert_clauses {
      clause {
        id: 'drag';
        interval {
          x {
            field: "x";
            from: start_coord(x);
            to: event_coord(x);
          }
        }
      }
    }
    set cursor = 'crosshair';
  }
}
