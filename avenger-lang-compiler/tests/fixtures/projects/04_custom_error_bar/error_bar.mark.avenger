avenger 1;

define mark error_bar {
  slot expr as category;
  slot expr as low;
  slot expr as high;
  slot expr as center;
  export body.stem as stem;
  export body.point as point;

  group as body {
    mark rule as stem {
      x: category;
      x2: category;
      y: low;
      y2: high;
      stroke: value '#374151';
      stroke_width: 2;
    }

    mark symbol as point {
      x: category;
      y: center;
      fill: value '#111827';
      size: 42;
    }
  }
}
