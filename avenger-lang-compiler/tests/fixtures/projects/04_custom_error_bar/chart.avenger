avenger 1;
import { error_bar } from 'error_bar.avenger';

chart cartesian as chart {
  data: {
    values: [ {
      category: 'A';
      center: 2.0;
      high: 3.0;
      low: 1.0;
    }
    , {
      category: 'B';
      center: 3.5;
      high: 5.0;
      low: 2.0;
    }
    ];
  }
  mark error_bar as errors {
    annotations: {
      mark text as labels {
        text: encoded "category";
        x: encoded "category";
        y: encoded "center";
      }
    }
    category: "category";
    category_axis: x;
    center: "center";
    high: "high";
    low: "low";
    mode: show;
    value_axis: y;
    part point {
      fill: direct '#dc2626';
      size: direct 64;
    }
  }
  widget slider as threshold {
    default: 2.0;
    max: 10.0;
    min: 0.0;
    position: bottom;
  }
}
