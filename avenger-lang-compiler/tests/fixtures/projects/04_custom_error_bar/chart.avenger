avenger 1;

import 'error_bar.mark.avenger';

chart cartesian as chart {
  data: {
    values: [
      { category: 'A'; low: 1.0; high: 3.0; center: 2.0; },
      { category: 'B'; low: 2.0; high: 5.0; center: 3.5; }
    ];
  }

  mark error_bar as errors {
    category_axis: x;
    value_axis: y;
    category: "category";
    low: "low";
    high: "high";
    center: "center";
    mode: show;
    annotations: {
      mark text as labels {
        x: "category";
        y: "center";
        text: "category";
      }
    }

    part point {
      fill: value '#dc2626';
      size: value 64;
    }
  }

  widget slider as threshold {
    position: bottom;
    min: 0.0;
    max: 10.0;
    default: 2.0;
  }

}
