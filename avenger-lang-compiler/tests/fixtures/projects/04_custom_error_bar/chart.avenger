avenger 1;

import 'error_bar.mark.avenger';

chart cartesian as chart {
  data: {
    values: [
      { category: 'A'; low: 1.0; high: 3.0; center: 2.0; },
      { category: 'B'; low: 2.0; high: 5.0; center: 3.5; }
    ];
  }

  mark error_bar as errors {
    category: "category";
    low: "low";
    high: "high";
    center: "center";

    part point {
      fill: value '#dc2626';
      size: 64;
    }
  }
}
