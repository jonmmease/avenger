avenger 1;
chart cartesian as chart {
  data: {
    values: [ {
      amount: CAST(2.0 AS DOUBLE);
      category: 'A';
    }
    , {
      amount: CAST(3.0 AS DOUBLE);
      category: 'A';
    }
    , {
      amount: CAST(4.0 AS DOUBLE);
      category: 'B';
    }
    , {
      amount: CAST(6.0 AS DOUBLE);
      category: 'B';
    }
    ];
  }
  mark group as summarized {
    transform aggregate as totals {
      expressions: sum("amount") AS total;
      group_by: ["category"];
    }
    transform sql as doubled {
      query: SELECT category, total * 2.0 AS doubled FROM input ORDER BY category;
    }
    mark symbol as points {
      fill: encoded "category" {
        legend: {
          position: right;
          title: 'Category';
        }
        scale: ordinal {
          range: ['#5778a4', '#e49444'];
        }
      }
      size: direct 100.0;
      x: encoded "category" {
        axis: {
          title: 'Category';
        }
        scale: point;
      }
      y: encoded "doubled" {
        axis: {
          title: 'Doubled Total';
        }
        scale: linear {
          zero: true;
        }
      }
    }
  }
}
