avenger 1;

chart cartesian as mark_effects {
  data: { values: [
    { name: 'A'; x: 1.0; y: 2.0; },
    { name: 'B'; x: 2.0; y: 1.0; }
  ]; }

  mark symbol as points {
    x: "x" { scale: linear { domain: [0.0, 3.0]; } }
    y: "y" { scale: linear { domain: [0.0, 3.0]; } }
    size: value 80.0;

    adjust expr {
      x: item_channel(x) + 4.0;
      y: item_channel(y) - 2.0;
    }

    adjust nudge as nudged {
      dx: 1.0;
      dy: -1.0;
      apply: { x: nudged.x; y: nudged.y; }
    }

    adjust jitter as jittered {
      axis: x;
      width_px: 8.0;
      seed: 7;
      apply: { x: jittered.x; y: jittered.y; }
    }

    adjust dodge as dodged {
      axis: y;
      by: name;
      step_px: 3.0;
      apply: { x: dodged.x; y: dodged.y; }
    }

    derive symbol as halos {
      x: item_channel(x);
      y: item_channel(y);
      size: 140.0;
      fill: '#00000000';
      stroke: '#111827';
      zindex: 1;
    }

    derive rule as leaders {
      x: item_bbox(left);
      x2: item_bbox(right);
      y: item_bbox(bottom) + 2.0;
      y2: item_bbox(bottom) + 2.0;
      stroke: '#6b7280';
      zindex: 2;
    }

    derive text as labels {
      text: item_data('name');
      x: item_channel(x);
      y: item_bbox(top) - 4.0;
      zindex: 5;
    }
  }

  mark rect as tiles {
    x: "x";
    x2: "x" + 0.25;
    y: "y";
    y2: "y" + 0.25;
    fill: value '#dbeafe';

    derive rect as backplates {
      x: item_bbox(left) - 1.0;
      x2: item_bbox(right) + 1.0;
      y: item_bbox(top) - 1.0;
      y2: item_bbox(bottom) + 1.0;
      fill: '#ffffff';
      opacity: 0.25;
      zindex: 0;
    }
  }
}
