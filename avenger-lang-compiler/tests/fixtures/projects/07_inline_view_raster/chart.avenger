avenger 1;
chart cartesian as chart {
  data: {
    values: [ {
      x: 0.0;
      y: 0.0;
    }
    , {
      x: 0.2;
      y: 0.8;
    }
    , {
      x: 0.4;
      y: 0.3;
    }
    , {
      x: 0.6;
      y: 0.7;
    }
    , {
      x: 0.8;
      y: 0.2;
    }
    , {
      x: 1.0;
      y: 1.0;
    }
    ];
  }
  mark uniform_raster_2d as density {
    opacity_by_total: {
      scale: linear {
        range: [0.15, 1.0];
      }
    }
    raster: pixels.raster;
    smooth: true;
    x: dim pixels.x_dim {
      axis: {
        title: 'X';
      }
    }
    y: dim pixels.y_dim {
      axis: {
        title: 'Y';
      }
    }
    view cartesian as viewport {
      stale_policy: retarget_cached;
      throttle_ms: 16;
      x_domain: "x";
      y_domain: "y";
      transform rasterize_2d as pixels {
        agg: count;
        x: "x";
        x_dim: {
          bins: 32;
          extent: [viewport.x.domain.start, viewport.x.domain.end];
        }
        y: "y";
        y_dim: {
          bins: 32;
          extent: [viewport.y.domain.start, viewport.y.domain.end];
        }
      }
    }
  }
}
