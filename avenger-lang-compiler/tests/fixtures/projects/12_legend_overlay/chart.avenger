avenger 1;
chart cartesian as chart {
  data: {
    values: [ {
      value: CAST(2.0 AS DOUBLE);
      x: CAST(1.0 AS DOUBLE);
      y: CAST(2.0 AS DOUBLE);
    }
    , {
      value: CAST(5.0 AS DOUBLE);
      x: CAST(2.0 AS DOUBLE);
      y: CAST(3.5 AS DOUBLE);
    }
    , {
      value: CAST(8.0 AS DOUBLE);
      x: CAST(3.0 AS DOUBLE);
      y: CAST(2.8 AS DOUBLE);
    }
    ];
  }
  mark symbol as points {
    fill: encoded "value" {
      legend: {
        overlay: {
          mark group as selected_range {
            data: {
              values: [ {
                hi: CAST(7.0 AS DOUBLE);
                lo: CAST(2.0 AS DOUBLE);
              }
              ];
            }
            transform filter {
              predicate: "hi" > "lo";
            }
            mark rect as band {
              fill: direct 'rgba(37, 99, 235, 0.20)';
              stroke: direct '#2563eb';
              stroke_width: direct 1.5;
              x: encoded 0.0;
              x2: encoded 1.0;
              y: encoded "lo";
              y2: encoded "hi";
            }
          }
        }
        title: 'Value';
      }
      scale: linear {
        domain: [0.0, 10.0];
        nice: false;
        zero: false;
      }
    }
    size: direct 110.0;
    stroke: direct '#ffffff';
    stroke_width: direct 1.0;
    x: encoded "x" {
      axis: {
        title: 'X';
      }
      scale: linear;
    }
    y: encoded "y" {
      axis: {
        title: 'Y';
      }
      scale: linear;
    }
  }
}
