avenger 1;
chart cartesian as chart {
  data: {
    values: [ {
      category: 'A';
      value: 2.0;
    }
    , {
      category: 'B';
      value: 4.0;
    }
    ];
  }
  transform pipeline as summary {
    output doubled;
    output adjusted;
    transform sql as __av_6f177da9e72b_calculate {
      query: SELECT *, "value" * 2.0 AS __summary_6f177da9e72b_doubled, "value" * 3.0 AS __summary_6f177da9e72b_tripled FROM input;
    }
    transform filter {
      predicate: true;
    }
    transform sql as __av_6f177da9e72b_finalize {
      query: SELECT *, __summary_6f177da9e72b_doubled AS doubled, __summary_6f177da9e72b_tripled + 1.0 AS adjusted, 99.0 AS __summary_6f177da9e72b_scratch FROM input;
    }
  }
  transform sql {
    query: SELECT * FROM input;
  }
  mark symbol as points {
    size: value 80;
    x: "category";
    y: summary.adjusted;
  }
}
