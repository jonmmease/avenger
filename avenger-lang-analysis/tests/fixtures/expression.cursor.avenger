avenger 1;

chart cartesian as chart {
    param float64 as point_size {
        value: 64.0;
    }
    param float64 as canvas_width {
        value: 640.0;
    }
    param float64 as canvas_height {
        value: 420.0;
    }

    mark symbol as points {
        x: "Horsepower";
        y: ⟦cursor⟧;
    }
}
