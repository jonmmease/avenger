avenger 1;
define mark badge {
  -- | Radius exposed by the definition.
  slot number as radius {
    default: 4;
  }
  slot enum as style {
    default: dot;
    values: [dot, line];
  }
  slot block as content;
  channel x;
  output bounds: span(0, "__avenger_binding_00000000");
  export points as marks;
  private group as implementation {
    public mark symbol as points {
      size: $radius;
      x: channel(x);
    }
    match style {
      dot {
        mark symbol {
        }
      }
      line {
        mark line {
        }
      }
    }
    content;
  }
}
