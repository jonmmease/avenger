avenger 1;
chart cartesian {
  on pointermove {
    replace brush {
      clause {
        id: 'primary';
        equality {
          category {
            field: "category";
            value: datum."category";
          }
        }
        interval {
          x {
            field: "x";
            from: event.start.coord.x;
            to: event.coord.x;
          }
        }
      }
      fields {
        values: [ {
          field: "x";
          id: 'x';
        }
        , {
          field: "category";
          id: 'category';
        }
        ];
      }
    }
  }
}
