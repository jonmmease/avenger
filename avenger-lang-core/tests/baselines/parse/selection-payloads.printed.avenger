avenger 1;
chart cartesian {
  on pointermove {
    set brush = update {
      clause {
        id: 'primary';
        equality {
          category {
            field: "category";
            value: datum('category');
          }
        }
        interval {
          x {
            field: "x";
            from: start_coord(x);
            to: event_coord(x);
          }
        }
      }
      fields {
        values: [ {
          field: "x";
          id: 'x';
        }
        , {
          field: "category";
          id: 'category';
        }
        ];
      }
    }
  }
}
