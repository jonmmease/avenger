avenger 1;

chart cartesian {
  on pointermove {
    set brush = update {
      clause {
        id: 'primary';
        equality {
          category {
            field: "category";
            value: datum."category";
          }
        }
        interval {
          x {
            field: "x";
            from: event.start.coord.x;
            to: event.coord.x;
          }
        }
      }
      fields {
        values: [
          { id: 'x'; field: "x"; },
          { id: 'category'; field: "category"; },
        ];
      }
    }
  }
}
