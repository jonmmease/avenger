avenger 1;

define tool brush {
  slot enum mode { values: [x, y, xy]; default: xy; }
  export behavior.brush as selection;

  tool behavior as behavior {
    param selection as brush { empty: none; }
    on pointermove as drag {
      target: marks [points, overlays.handles,];
      scope: subplots [cells.left, cells.right];
      surface: legend color;
      set brush = update { mode: $mode; }
      set cursor = 'crosshair';
    }
    scale_edit { target: plot; }
  }
}
