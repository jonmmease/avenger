avenger 1;

chart responsive as shapes {
  resource tiles as osm {}
  theme css: '.chart { color: red; }';
  container group as container {
    variable row mpg {}
    cell cartesian as left at { row: 0; column: 1; } {
      plot polar {
        mark arc {}
      }
    }
    part label {}
    level 0 {}
    adjust stack as stacked {}
    derive density as kde {}
    container overlay as annotations {}
    layer background {}
    when {}
    row {}
    field struct(field(float64, 'x'), field(list(utf8), 'labels')) payload nullable;
    key {}
    fields {}
    scale_hint {}
    widget slider as opacity {}
    view raster as image {}
    tool pan;
  }
}
