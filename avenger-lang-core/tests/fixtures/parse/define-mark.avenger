avenger 1;

define mark badge {
  -- | Radius exposed by the definition.
  slot number radius { default: 4; }
  slot enum style { values: [dot, line]; default: dot; }
  slot block content;
  slot channel x;
  output span(0, $radius) as bounds;
  export points as marks;

  private container group as implementation {
    public mark symbol as points {
      x: channel(x);
      size: $radius;
    }
    match style {
      dot { mark symbol {} }
      line { mark line {} }
    }
    content;
  }
}
