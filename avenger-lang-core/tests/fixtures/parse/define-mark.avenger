avenger 1;

define mark badge {
  -- | Radius exposed by the definition.
  slot number as radius { default: 4; }
  slot enum as style { values: [dot, line]; default: dot; }
  slot block as content;
  channel x;
  output bounds: span(0, $radius);
  export points as marks;

  private group as implementation {
    public mark symbol as points {
      x: channel(x);
      size: $radius;
    }
    match style {
      dot { mark symbol {} }
      line { mark line {} }
    }
    content;
  }
}
