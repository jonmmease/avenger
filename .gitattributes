# GitHub syntax highlighting
pixi.lock linguist-language=YAML

# The world gallery data, which tools/geo-world-data/prepare.py rebuilds
avenger-guides-geo/examples/data/*.arrows filter=lfs diff=lfs merge=lfs -text

# The movie search example's data
examples/movie-search/data/*.csv filter=lfs diff=lfs merge=lfs -text

# The Vega datasets of avenger-sql-project's fixture project
avenger-sql-project/tests/projects/vega/data/files/vega_datasets/* filter=lfs diff=lfs merge=lfs -text

# Docs images, which READMEs show
**/docs/images/*.png filter=lfs diff=lfs merge=lfs -text

# The bundle of the Quarto 2 extension, which q2 call build-ts-extension builds from its source
avenger-cli/quarto2/_extensions/avenger/dist/** linguist-generated=true

# The tree-sitter grammar of avenger-sql, which quarto2/scripts/sync-grammar.mjs copies from
# tree-sitter-avenger-sql, in Git, since the CLI embeds it
avenger-cli/quarto2/grammars/** linguist-generated=true
avenger-cli/quarto2/grammars/**/*.wasm binary
